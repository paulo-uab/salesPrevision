@startuml enums
enum FileType {
  CSV
  JSON
  XLSX
  TXT
  UNKNOWN
}

enum FieldDataType {
  STRING
  INTEGER
  LONG
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
}

enum TemplateRuleType {
  NOT_NULL
  REGEX
  MIN
  MAX
  ENUM
  DATE_FORMAT
}

enum IngestionStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum ValidationStatus {
  VALID
  INVALID
  WARNING
}

enum TransformationType {
  NONE
  RENAME
  SCALE
  DATE_FORMAT
  CAST
  REPLACE
}

enum FilterOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  IS_NULL
  IS_NOT_NULL
  BETWEEN
  CONTAINS
}

enum LogicalOperator {
  AND
  OR
}

enum BatchExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ForecastFieldRole {
  NONE
  DATE
  TARGET
  GROUP
  EXOG
}
note right of ForecastFieldRole
  Marks the role of a PipelineField (after transformation, keyed by
  targetFieldName) in the forecast sent to prediction-service.
  batch-service's ForecastItemWriter.buildForecastConfig() derives
  date_field/target_fields/exog_fields/group_field straight from this,
  with no separate forecast configuration to keep in sync.
end note

enum ServiceRole {
  TEMPLATE_READ
  TEMPLATE_EDIT
  TEMPLATE_EXECUTE
  INGESTION_READ
  INGESTION_EDIT
  INGESTION_EXECUTE
  PIPELINE_READ
  PIPELINE_EDIT
  PIPELINE_EXECUTE
  BATCH_READ
  BATCH_EDIT
  BATCH_EXECUTE
  USER_READ
  USER_EDIT
}
note right of ServiceRole
  Per-service authority granted to a user via user-service, carried as
  the "roles" claim in the JWT. An "admin" is simply a user holding
  every value here — there is no separate ADMIN/USER role.
end note
@enduml
