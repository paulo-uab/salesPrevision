@startuml validation-flow
participant "CsvIngestionProcessor" as CSV
participant "AbstractIngestionProcessor" as ABS

CSV -> ABS : convertAndValidateField(field, rawValue)

ABS -> ABS : StringUtils.hasText(rawValue)?
alt em branco/nulo E (field.required ou existe regra NOT_NULL activa)
  ABS --> CSV : FieldValidationException("VALIDATION",\n"error.field.required")
else em branco/nulo, sem obrigatoriedade
  ABS --> CSV : null (sem erro)
else tem valor
  ABS -> ABS : field.validationRegex definido?\ntrimmed.matches(validationRegex)
  alt regex do campo falha
    ABS --> CSV : FieldValidationException("REGEX",\n"error.field.regex")
  end

  ABS -> ABS : convertValue(field, trimmed) — Conversão de tipo (dataType)
  note right: STRING → valor tal-e-qual\nINTEGER → Integer.valueOf()\nLONG → Long.valueOf()\nDECIMAL → new BigDecimal()\nBOOLEAN → parseBoolean() (true/1/yes/y/sim/s ...)\nDATE → LocalDate.parse(dateFormat)\nDATETIME → LocalDateTime.parse(dateFormat)\nNumberFormatException/DateTimeParseException →\nFieldValidationException("TYPE_CONVERSION", ...)

  ABS -> ABS : applyRules(field, trimmed, converted)
  loop Para cada TemplateValidationRule activa
    alt NOT_NULL
      ABS -> ABS : converted != null
    else REGEX
      ABS -> ABS : trimmed.matches(rule.ruleValue)
    else MIN
      ABS -> ABS : toBigDecimal(converted) >= new BigDecimal(rule.ruleValue)
    else MAX
      ABS -> ABS : toBigDecimal(converted) <= new BigDecimal(rule.ruleValue)
    else ENUM
      ABS -> ABS : trimmed in rule.ruleValue.split(",")
    else DATE_FORMAT
      ABS -> ABS : parseDate(rule.ruleValue, trimmed)
    end
    note right: Mensagem de erro = rule.message (se definida)\nou fallback pt via MessageSource
  end

  ABS --> CSV : Valor normalizado (converted)\nou FieldValidationException por regra falhada
end
@enduml
